# Provide AT LEAST ONE of the following API keys based on your preference

# Option 1: OpenAI (Default)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Groq (If you want to use Groq's fast Llama models)
GROQ_API_KEY=your_groq_api_key_here

# Option 3: Local Ollama
# No API key required. Make sure Ollama is running locally on port 11434 and you have pulled a model (e.g., `ollama run llama3`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
